PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_MODE=memory
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app-name>
JWT_SECRET=
NODE_ENV=development
SEED_DEMO_DATA=false
# Optional local administrator; set both values explicitly to enable this account.
# ASTER_DEMO_ADMIN_EMAIL=admin@example.test
# ASTER_DEMO_ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
